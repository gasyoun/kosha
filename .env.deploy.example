# Restricted-tier backup deploy (scripts/deploy_guhya.py).
#
# The transport is FTPS since W0B (H1944): explicit AUTH TLS on the control
# channel and PROT P on the data channel. There is no plaintext fallback — a
# server that cannot negotiate TLS fails the deploy rather than downgrading, so
# these credentials are never sent in the clear.
#
# FTP_PORT stays 21: that is *explicit* FTPS (connect, then AUTH TLS), not the
# deprecated implicit-TLS port 990.
FTP_HOST=t3cloud.ru
FTP_USER=your-ftp-username
FTP_PASS=your-ftp-password
FTP_PATH=www/samskrtam.ru/guhya/
FTP_PORT=21
