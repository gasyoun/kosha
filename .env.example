# kosha environment template — copy to .env
#
# Storage (D7). Each store is a separate file so a dictionary rebuild never
# touches visitor data and attached layers can move independently.
KOSHA_CORE_DB_PATH=./data/db/kosha.db
# KOSHA_INFLECTIONS_DB_PATH=./data/db/kosha_inflections.db
# KOSHA_LAYERS_DB_PATH=./data/db/kosha_layers.db
# Immutable citation archive mount (D9), checked by the release gate.
# KOSHA_ARCHIVE_DIR=./data/archive
#
# DEPRECATED alias for KOSHA_CORE_DB_PATH, kept because .env files in the wild
# still carry it. Setting BOTH to different files is a hard error, not a
# silent winner. Its old template value (./unified_dict.db) never matched the
# path the code actually opened — corrected 31-07-2026, H1944.
# DATABASE_PATH=./data/db/kosha.db
LOG_LEVEL=INFO
# NB: cookie-scoped personal history (/api/v1/history, /api/v1/auth/*) needs
# credentialed CORS, which Starlette refuses to combine with a wildcard
# origin. In production, set this to an explicit list, e.g.
# CORS_ORIGINS=["https://samskrtam.ru", "https://gasyoun.github.io"]
CORS_ORIGINS=["*"]
# Cologne scans are served by csl-websanlexicon serveimg/servepdf:
COLOGNE_SCAN_BASE=https://www.sanskrit-lexicon.uni-koeln.de
# Heritage (INRIA) DICO link-out base for the H345 coverage witness
# (heritage_anchor.anchor paths are site-relative: DICO/<n>.html#<key>):
HERITAGE_DICO_BASE=https://sanskrit.inria.fr/
# Optional pwg_ru / mw_ru join root (H2670). Unset → sibling
# SanskritLexicography/RussianTranslation next to this repo. CI pins
# tests/fixtures/ru_join/. Do not point this at Kochergina or SanskritRussian.
# KOSHA_RU_JOIN=/opt/kosha/SanskritLexicography/RussianTranslation

# D10 — history, magic-link auth, and analytics are OFF for public v1. While
# this is unset/false, /api/v1/history, /api/v1/auth/*, and /api/v1/stats/*
# are not mounted at all (404, absent from the OpenAPI schema) and /api/v1/
# search mints no visitor cookie and writes no event.
KOSHA_HISTORY_ENABLED=false
# Search-history / analytics store (separate SQLite file from the read-only
# dictionary DB, so the monthly dict rebuild never touches it). Defaults to
# data/db/kosha_history.db if unset. Only opened when history is enabled.
HISTORY_DB_PATH=./data/db/kosha_history.db
# W1C readiness (GET /ready): when set, fail closed if meta.data_version
# disagrees. Leave unset in local dev; pin in production deploy bundles.
# KOSHA_EXPECTED_DATA_VERSION=1.2.0
# Salt for hashing visitor IPs before storage — never store raw IPs. Set a
# real random value in production; the default is dev-only.
HISTORY_IP_SALT=kosha-dev-salt
