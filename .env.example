# kosha environment template — copy to .env
#
# Settings are typed and validated in src/kosha/settings.py (W0B, H1944).
# Anything below can also be set as a real environment variable.

# --- databases ---------------------------------------------------------------
# The dictionary database the API reads and the build chain writes.
KOSHA_CORE_DB=./data/db/kosha.db
# DEPRECATED alias for KOSHA_CORE_DB. It is still honoured (with a
# DeprecationWarning) because it was advertised here for a long time — during
# which nothing actually read it, so setting it changed nothing and said
# nothing. Setting BOTH to different paths is now a hard error rather than a
# coin flip over which wins.
# DATABASE_PATH=./unified_dict.db

# Role-addressed databases. Both default to KOSHA_CORE_DB: the physical split
# is not implemented (it is an explicit W0B non-goal), but the build chain and
# the service already address these by role, so splitting them later is a
# config change rather than a code change.
# KOSHA_INFLECTIONS_DB=./data/db/kosha.db
# KOSHA_LAYERS_DB=./data/db/kosha.db

# Per-release sense archives that old citations resolve against (RISKS.md R1).
# `KOSHA_RELEASES_DIR` remains an accepted spelling of the same setting.
# KOSHA_ARCHIVE_DIR=./data/releases

# --- service -----------------------------------------------------------------
LOG_LEVEL=INFO
# NB: cookie-scoped personal history (/api/v1/history, /api/v1/auth/*) needs
# credentialed CORS, which Starlette refuses to combine with a wildcard
# origin. In production, set this to an explicit list, e.g.
# CORS_ORIGINS=["https://samskrtam.ru", "https://gasyoun.github.io"]
CORS_ORIGINS=["*"]
# Cologne scans are served by csl-websanlexicon serveimg/servepdf:
COLOGNE_SCAN_BASE=https://www.sanskrit-lexicon.uni-koeln.de
# Heritage (INRIA) DICO link-out base for the H345 coverage witness
# (heritage_anchor.anchor paths are site-relative: DICO/<n>.html#<key>):
HERITAGE_DICO_BASE=https://sanskrit.inria.fr/
# Public base for durable citation URLs — deliberately NOT the samskrtam.ru
# deployment host (RISKS.md R1/R5).
# KOSHA_PUBLIC_BASE=http://localhost:8000

# --- search history / analytics (OFF by default) ------------------------------
# The personal-history, magic-link auth and aggregate-stats routes are not
# mounted unless this is on: they 404, and no search is written to the visitor
# store. W0's public surface is the dictionary.
KOSHA_ENABLE_HISTORY=0
# Where that store lives when it IS on. Separate SQLite file from the
# read-only dictionary DB, so the rebuild never touches it.
# `HISTORY_DB_PATH` remains an accepted spelling of the same setting.
KOSHA_HISTORY_DB=./data/db/kosha_history.db
# Salt for hashing visitor IPs before storage — never store raw IPs. Set a
# real random value in production; the default is dev-only.
HISTORY_IP_SALT=kosha-dev-salt
